    {
      "role": "user",
      "content": "<file name=\"t12.csv\">\naccount,classification,annual_usd\nRental income,operating_revenue,240000\nRent abatements,contra_revenue,-6000\nExpense reimbursements,operating_revenue,12000\nProperty taxes,operating_expense,30000\nInsurance,operating_expense,12000\nRepairs,operating_expense,18000\nUtilities,operating_expense,24000\nManagement,operating_expense,12000\nRoof replacement,capital_expenditure,40000\nDebt service,financing,90000\n\n</file>\n\n<file name=\"rent-roll.csv\">\nunit,unit_type,area_sf,status,commencement,monthly_rent_usd\n101,studio,500,active,2024-01-01,1200\n102,studio,500,active,2024-06-01,1200\n103,studio,500,vacant,,\n104,studio,500,pending,2026-02-01,1200\n201,1br,700,active,2024-01-01,1600\n202,1br,700,active,2024-01-01,1600\n203,1br,700,active,2024-01-01,1600\n204,1br,700,active,2024-01-01,1600\n301,2br,900,active,2024-01-01,2000\n302,2br,900,active,2024-01-01,2000\n303,2br,900,active,2024-01-01,2000\n304,2br,900,vacant,,\n\n</file>\n\n<file name=\"source-summary.json\">\n{\n  \"reported_occupied_units\": 10,\n  \"reported_occupied_area_sf\": 7000,\n  \"reported_annual_in_place_rent\": 192000,\n  \"note\": \"The preparer's occupied total includes the signed pending lease.\"\n}\n\n</file>\n\n<file name=\"sizing-inputs.json\">\n{\n  \"property\": \"Harbor Court (fictional)\",\n  \"as_of\": \"2025-12-31\",\n  \"t12_period\": \"2025-01-01 through 2025-12-31\",\n  \"valuation\": 2400000,\n  \"max_ltv\": 0.65,\n  \"min_dscr\": 1.25,\n  \"min_debt_yield\": 0.09,\n  \"annual_interest_rate\": 0.07,\n  \"debt_service_method\": \"interest_only\"\n}\n\n</file>\n\n<file name=\"prompt.md\">\n# Harbor Court: extraction, reconciliation and sizing\n\nThis is a fictional public development example. It is not a held-out evaluation.\nUse t12.csv, rent-roll.csv, source-summary.json and sizing-inputs.json only.\nPrepare answer.json using the fields and canonical source references in output-contract.json.\n\nCalculate operating revenue including abatements and reimbursements. Calculate\noperating expenses excluding capital expenditure and debt service. NOI equals the difference.\nDistinguish active, pending and vacant units at the as-of date. In-place occupancy\nand rent exclude pending leases. Report unit and area occupancy independently.\nProvide total and occupied counts for each unit type. Preserve the source-reported\nsummary separately. Report every identified conflict and select the supported resolution.\nT-12 rental income is historical and need not equal annualized rent at the as-of date.\n\nSize an interest-only loan: LTV limit = value \u00d7 max LTV; DSCR limit = NOI \u00f7\n(min DSCR \u00d7 annual interest rate); debt-yield limit = NOI \u00f7 minimum debt yield.\nMaximum proceeds is the minimum; name the binding constraint. Dollars for loan\nlimits round to the nearest dollar; occupancy percentages to two decimals.\n\nOutput JSON with exactly fields and discrepancies. Each field contains value and\nevidence (a unique list of canonical source references). Use numbers as JSON numbers.\ndiscrepancies is a unique list of supported conflict IDs in the contract; do not invent conflicts.\nThe resolution enum records the selected action; it does not prove prose reasoning.\nDo not read answer-key.json or reference-answer.json if using this as practice.\nThese keys are public, so this packet is never eligible for hidden-set performance claims.\n\n</file>\n\n<file name=\"output-contract.json\">\n{\n  \"fields\": {\n    \"operating_revenue\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"t12.csv:2-4\"\n      ]\n    },\n    \"operating_expenses\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"t12.csv:5-9\"\n      ]\n    },\n    \"noi\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"t12.csv:2-4\",\n        \"t12.csv:5-9\"\n      ]\n    },\n    \"total_units\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"occupied_units\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"vacant_units\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"pending_units\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"total_area_sf\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"occupied_area_sf\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"unit_occupancy_pct\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"area_occupancy_pct\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"annual_in_place_rent\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"studio_total_units\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"studio_occupied_units\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"1br_total_units\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"1br_occupied_units\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"2br_total_units\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"2br_occupied_units\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\"\n      ]\n    },\n    \"reported_occupied_units\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"source-summary.json:/reported_occupied_units\"\n      ]\n    },\n    \"reported_occupied_area_sf\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"source-summary.json:/reported_occupied_area_sf\"\n      ]\n    },\n    \"reported_annual_in_place_rent\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"source-summary.json:/reported_annual_in_place_rent\"\n      ]\n    },\n    \"ltv_limit\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"sizing-inputs.json:/valuation\",\n        \"sizing-inputs.json:/max_ltv\"\n      ]\n    },\n    \"dscr_limit\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"t12.csv:2-4\",\n        \"t12.csv:5-9\",\n        \"sizing-inputs.json:/min_dscr\",\n        \"sizing-inputs.json:/annual_interest_rate\"\n      ]\n    },\n    \"debt_yield_limit\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"t12.csv:2-4\",\n        \"t12.csv:5-9\",\n        \"sizing-inputs.json:/min_debt_yield\"\n      ]\n    },\n    \"max_loan\": {\n      \"type\": \"number\",\n      \"canonical_evidence\": [\n        \"t12.csv:2-4\",\n        \"t12.csv:5-9\",\n        \"sizing-inputs.json:/valuation\",\n        \"sizing-inputs.json:/max_ltv\",\n        \"sizing-inputs.json:/min_dscr\",\n        \"sizing-inputs.json:/annual_interest_rate\",\n        \"sizing-inputs.json:/min_debt_yield\"\n      ]\n    },\n    \"binding_constraint\": {\n      \"type\": \"string\",\n      \"canonical_evidence\": [\n        \"t12.csv:2-4\",\n        \"t12.csv:5-9\",\n        \"sizing-inputs.json:/valuation\",\n        \"sizing-inputs.json:/max_ltv\",\n        \"sizing-inputs.json:/min_dscr\",\n        \"sizing-inputs.json:/annual_interest_rate\",\n        \"sizing-inputs.json:/min_debt_yield\"\n      ]\n    },\n    \"resolution\": {\n      \"type\": \"string\",\n      \"canonical_evidence\": [\n        \"rent-roll.csv:2-13\",\n        \"sizing-inputs.json:/as_of\",\n        \"source-summary.json:/note\"\n      ]\n    }\n  },\n  \"conflict_ids\": [\n    \"pending_in_reported_occupied_units\",\n    \"pending_in_reported_occupied_area\",\n    \"pending_in_reported_rent\",\n    \"historical_revenue_differs_from_current_rent\"\n  ],\n  \"resolution_values\": [\n    \"exclude_pending_from_in_place\",\n    \"use_reported_summary\"\n  ]\n}\n\n</file>"
