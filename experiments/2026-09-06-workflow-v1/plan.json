      "type": "function",
      "function": {
        "name": "calculate_batch",
        "description": "Preferred for related calculations: evaluate named arithmetic steps in order. Later expressions can refer to names of earlier results. Same arithmetic/functions as calculate. No file access or domain-specific answers. Example steps [{name:\"revenue\",expression:\"1200*12\"},{name:\"net\",expression:\"revenue-4000\"}].",
