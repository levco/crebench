          "value": "Sizing debt yield (UW NCF / loan)",
          "role": "header"
        },
        {
          "cell": "B13",
          "formula": "='UW'!B18/B10",
          "number_format": "0.000"
        },
        {
          "cell": "A14",
          "value": "First-year contractual debt service (IO year)",
          "role": "header"
        },
        {
          "cell": "B14",
          "formula": "='Inputs'!B8*B10",
          "number_format": "$#,##0"
