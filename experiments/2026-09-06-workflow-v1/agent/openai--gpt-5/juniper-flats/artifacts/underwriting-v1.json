          "number_format": "0.00%"
        },
        {
          "cell": "A5",
          "value": "LTV limit ($)",
          "role": "header"
        },
        {
          "cell": "B5",
          "formula": "=B4*B3",
          "number_format": "$#,##0"
        },
        {
          "cell": "A6",
          "value": "DSCR limit ($) = NCF / (const * 1.25)",
          "role": "header"
        },
        {
          "cell": "B6",
          "formula": "='UW'!B18/(B2*1.25)",
          "number_format": "$#,##0"
        },
        {
          "cell": "A7",
          "value": "Debt yield minimum",
          "role": "header"
        },
        {
          "cell": "B7",
          "formula": "='Inputs'!B29",
          "number_format": "0.00%"
        },
        {
          "cell": "A8",
          "value": "Debt yield limit ($) = NCF / DY%",
          "role": "header"
        },
        {
          "cell": "B8",
          "formula": "='UW'!B18/B7",
          "number_format": "$#,##0"
        },
        {
          "cell": "A10",
          "value": "Maximum loan (min of constraints)",
          "role": "header"
        },
        {
          "cell": "B10",
          "formula": "=MIN(B5,B6,B8)",
          "number_format": "$#,##0"
        },
        {
          "cell": "A11",
          "value": "Sizing annual debt service",
          "role": "header"
        },
        {
          "cell": "B11",
          "formula": "=B10*B2",
          "number_format": "$#,##0"
        },
        {
