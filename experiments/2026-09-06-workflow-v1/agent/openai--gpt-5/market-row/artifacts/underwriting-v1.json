          "value": "Sizing DSCR",
          "role": "body"
        },
        {
          "cell": "A37",
          "formula": "=A23/A35",
          "role": "total",
          "number_format": "0.00"
        },
        {
          "cell": "A38",
          "value": "Sizing debt yield",
          "role": "body"
        },
        {
          "cell": "A39",
          "formula": "='Underwriting'!A38/A30",
          "role": "total",
          "number_format": "0.00%"
        },
