    {
      "name": "Value & Sizing",
      "cells": [
        {
          "cell": "A1",
          "value": "Market Row | Valuation and Loan Sizing",
          "role": "title"
        },
        {
          "cell": "A3",
          "value": "Cap rate",
          "role": "body"
        },
        {
          "cell": "A4",
          "formula": "=Inputs!B25",
          "role": "input",
          "number_format": "0.00%"
        },
        {
          "cell": "A5",
          "value": "Indicative value (NOI/cap)",
          "role": "header"
        },
        {
          "cell": "A6",
          "formula": "='Underwriting'!A38/A4",
          "role": "total",
          "number_format": "$#,##0"
        },
        {
          "cell": "A7",
          "value": "LTV limit (65%)",
          "role": "body"
        },
        {
          "cell": "A8",
          "formula": "=0.65*A6",
          "role": "total",
          "number_format": "$#,##0"
        },
        {
          "cell": "A10",
          "value": "Debt yield minimum",
          "role": "body"
        },
        {
          "cell": "A11",
          "formula": "=Inputs!B26",
          "role": "body",
          "number_format": "0.00%"
        },
        {
          "cell": "A12",
          "value": "Debt yield limit",
          "role": "body"
        },
        {
          "cell": "A13",
          "formula": "='Underwriting'!A38/A11",
          "role": "total",
          "number_format": "$#,##0"
        },
        {
          "cell": "A15",
          "value": "Sizing rate",
          "role": "body"
        },
        {
          "cell": "A16",
          "formula": "=Inputs!B28",
          "role": "input",
          "number_format": "0.00%"
        },
        {
          "cell": "A17",
          "value": "Amortization years",
          "role": "body"
        },
        {
          "cell": "A18",
          "formula": "=Inputs!B29",
          "role": "body"
        },
        {
          "cell": "A19",
          "value": "Annual debt constant",
          "role": "body"
        },
        {
          "cell": "A20",
          "formula": "=-12*PMT(A16/12,A18*12,1)",
          "role": "total",
          "number_format": "0.0000000000"
        },
        {
          "cell": "A22",
          "value": "NCF after reserves",
          "role": "body"
        },
        {
          "cell": "A23",
          "formula": "='Underwriting'!A46",
          "role": "total",
          "number_format": "$#,##0"
        },
        {
          "cell": "A24",
          "value": "DSCR minimum",
          "role": "body"
        },
        {
          "cell": "A25",
          "value": 1.25,
          "role": "body"
        },
        {
          "cell": "A26",
          "value": "DSCR limit",
          "role": "body"
        },
        {
          "cell": "A27",
          "formula": "=A23/(A25*A20)",
          "role": "total",
          "number_format": "$#,##0"
        },
        {
          "cell": "A29",
          "value": "Maximum loan (min of constraints)",
          "role": "header"
        },
        {
          "cell": "A30",
          "formula": "=MIN(A8,A13,A27)",
          "role": "total",
          "number_format": "$#,##0"
        },
        {
          "cell": "A31",
          "value": "Binding constraint",
          "role": "body"
        },
        {
          "cell": "A32",
          "formula": "=IF(A30=A27,\"DSCR\",IF(A30=A8,\"LTV\",\"Debt yield\"))",
          "role": "total"
        },
        {
          "cell": "A34",
          "value": "Sizing annual debt service",
          "role": "body"
        },
        {
          "cell": "A35",
          "formula": "=A20*A30",
          "role": "total",
          "number_format": "$#,##0"
        },
        {
