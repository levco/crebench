    {
      "name": "Sizing",
      "cells": [
        {
          "cell": "A1",
          "value": "Loan sizing",
          "role": "title"
        },
        {
          "cell": "A3",
          "value": "Cap rate",
          "role": "header"
        },
        {
          "cell": "B3",
          "formula": "='Assumptions'!B1",
          "number_format": "0.00%"
        },
        {
          "cell": "A4",
          "value": "Sizing rate (annual)",
          "role": "header"
        },
        {
          "cell": "B4",
          "formula": "='Assumptions'!B2",
          "number_format": "0.00%"
        },
        {
          "cell": "A5",
          "value": "Amortization (years)",
          "role": "header"
        },
        {
          "cell": "B5",
          "value": 25
        },
        {
          "cell": "A6",
          "value": "Annual debt constant at sizing rate",
          "role": "body"
        },
        {
          "cell": "B6",
          "formula": "=12*ABS(PMT(B4/12,B5*12,1))",
          "number_format": "0.000000000"
        },
        {
          "cell": "A8",
          "value": "Capitalization value (NOI before reserves / cap rate)",
          "role": "body"
        },
        {
          "cell": "B8",
          "formula": "='Underwriting'!B15/B3",
          "number_format": "$#,##0"
        },
        {
          "cell": "A9",
          "value": "LTV limit (62.5% of value)",
          "role": "body"
        },
        {
          "cell": "B9",
          "formula": "=0.625*B8",
          "number_format": "$#,##0"
        },
        {
          "cell": "A10",
          "value": "Debt yield limit (NOI before reserves / 9%)",
          "role": "body"
        },
        {
          "cell": "B10",
          "formula": "='Underwriting'!B15/0.09",
          "number_format": "$#,##0"
        },
        {
          "cell": "A11",
          "value": "DSCR limit (NCF / (1.25 x constant))",
          "role": "body"
        },
        {
          "cell": "B11",
          "formula": "='Underwriting'!B18/(1.25*B6)",
          "number_format": "$#,##0"
        },
        {
          "cell": "A12",
          "value": "Maximum loan (min of three)",
          "role": "total"
        },
        {
          "cell": "B12",
          "formula": "=MIN(B9,B10,B11)",
          "number_format": "$#,##0"
        },
        {
          "cell": "A14",
          "value": "Annual debt service at maximum (sizing rate)",
          "role": "body"
        },
        {
          "cell": "B14",
          "formula": "=B12*B6",
          "number_format": "$#,##0"
        },
        {
          "cell": "A15",
          "value": "Sizing DSCR (NCF / ADS)",
          "role": "body"
        },
        {
          "cell": "B15",
          "formula": "='Underwriting'!B18/B14",
          "number_format": "0.00"
        },
        {
          "cell": "A16",
          "value": "Sizing debt yield (NOI / Loan)",
          "role": "body"
        },
        {
          "cell": "B16",
          "formula": "='Underwriting'!B15/B12",
          "number_format": "0.00%"
        },
        {
          "cell": "A18",
          "value": "First-year contractual annual debt service",
          "role": "body"
        },
        {
          "cell": "B18",
          "formula": "=B14",
          "number_format": "$#,##0"
        },
        {
          "cell": "A21",
          "value": "Stress: EGI -5% and sizing rate +100 bps",
          "role": "header"
        },
        {
          "cell": "A22",
          "value": "Stress EGI",
          "role": "body"
